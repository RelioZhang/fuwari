---
// 看板娘（oh-my-live2d）
// 通过 CDN 引入，不新增任何 npm 依赖，因此不会让 pu
// npm 依赖清单产生冲突。
//
// 想彻底移除：删掉本文件，并删掉 MainGridLayout.astro 里的
//   import Live2D ... 与 <Live2D />
// 想临时关闭：浏览器控制台执行 localStorage.setItem("live2d", "off") 后刷新。
---

<script is:inline>
	(function () {
		var CDN = "https://cdn.jsdelivr.net/npm/oh-my-live2d@latest/dist/index.min.js";

		// 小屏不加载，避免遮挡正文
		if (window.matchMedia("(max-width: 1024px)").matches) return;
		// 手动关闭过就不再出现
		if (localStorage.getItem("live2d") === "off") return;

		function init() {
			if (!window.OML2D) return;
			window.OML2D.loadOml2d({
				models: [
					{
						path: "https://model.oml2d.com/HK416-1-normal/model.json",
						position: [0, 60],
						scale: 0.08,
						stageStyle: { height: 450 },
					},
				],
				mobileDisplay: false,
				primaryColor: "#5da9e9",
			});
		}

		function boot() {
			if (window.OML2D) return init();
			var s = document.createElement("script");
			s.src = CDN;
			s.async = true;
			s.onload = init;
			s.onerror = function () {
				// 加载失败就静默跳过，不影响正文
				console.warn("[live2d] CDN 加载失败，已跳过");
			};
			document.body.appendChild(s);
		}

		// 推迟 1.5s，不抢首屏渲染
		if (document.readyState === "complete") {
			setTimeout(boot, 1500);
		} else {
			window.addEventListener("load", function () {
				setTimeout(boot, 1500);
			});
		}
	})();
</script>
